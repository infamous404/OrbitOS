# OrbitOS settings (all optional). Copy this file to .env and change what you need.
# Paramètres OrbitOS (tous facultatifs). Copiez ce fichier en .env et modifiez ce qu'il faut.
#
# No passwords here: the database password is generated on first start and the
# administrator account is created on the setup page.
# Aucun mot de passe ici : celui de la base de données est généré au premier démarrage,
# et le compte administrateur est créé sur la page de configuration.

# Who can reach OrbitOS. 127.0.0.1 = this computer only (default). 0.0.0.0 = your network too.
# Qui peut joindre OrbitOS. 127.0.0.1 = cet ordinateur seulement. 0.0.0.0 = aussi votre réseau.
ORBITOS_BIND=127.0.0.1
ORBITOS_HTTP_PORT=8080
ORBITOS_MQTT_PORT=1883
ORBITOS_COAP_PORT=5683

# Language for emails and new users until changed on the setup page: en_US, en_CA, fr_FR, fr_CA.
# Langue des courriels et des nouveaux utilisateurs (modifiable sur la page de configuration).
ORBITOS_DEFAULT_LANGUAGE=en_US

# Product name shown everywhere (empty = name from orbitos/branding/branding.yml).
# Nom du produit affiché partout (vide = nom défini dans orbitos/branding/branding.yml).
ORBITOS_BRAND_NAME=

# Offline by default: the web interface only loads data from this server.
# true = allow free online map tiles (OpenStreetMap, Esri, CARTO); the browser then contacts them.
# Hors ligne par défaut. true = autoriser les fonds de carte en ligne gratuits.
ORBITOS_ONLINE_MAPS=false
# Other hosts the web interface may load from, separated by spaces, e.g. https://maps.example.ca
# Autres hôtes autorisés, séparés par des espaces.
ORBITOS_ALLOWED_HOSTS=

# Memory for the server (Java). 1 GB is enough for a small installation.
# Mémoire du serveur (Java). 1 Go suffit pour une petite installation.
ORBITOS_JAVA_OPTS=-Xms256m -Xmx1g -XX:+UseG1GC

# HTTPS (only with: docker compose --profile https up -d)
# ORBITOS_DOMAIN = the name people type. ORBITOS_TLS = internal (local certificate, offline)
# or your email address (free public certificate from Let's Encrypt, needs the internet).
ORBITOS_DOMAIN=localhost
ORBITOS_TLS=internal
ORBITOS_HTTPS_BIND=0.0.0.0

# Use a published image instead of building from source (then: docker compose up -d --no-build).
# Utiliser une image publiée au lieu de construire (puis : docker compose up -d --no-build).
# ORBITOS_IMAGE=ghcr.io/<owner>/orbitos:1.0.0
